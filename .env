#Версия приложения
alert_job_version=1.0.40
#Домен приложения
domain=aj.gdev.by
#Адрес сервера grafana
grafana_domain=grafana.gdev.by
#Адрес acme
acme_email=grovedev.by@gmail.com
#Директория базы данных
database_directory=/home/app/service/aj/files_prod/apps
#used this param by default, after change, cas another can't be worked
#Пароль админа Keycloak
keycloak_admin_password=admin
#Имя пользователя с ролью админ на сервере Keycloak
keycloak_admin=admin
#Репозиторий, где лежат конфигурацонные факты проекта
local_config_directory=/home/app/service/aj/sources/alert-job-config-repo
#Адрес сервера Keycloak
keycloak_url=https://aj.gdev.by/keycloak
#path to locale DIRECTORY which contains this file https://github.com/gdevby/alert-job/blob/main/parser-alert-job/src/main/resources/hubr.txt 
parser_config_directory=/home/app/service/aj/config/parser
#Директория Prometheus
prometheus_directory=/home/app/service/aj/config/prometheus
#Уровни логирования в приложении
logger_level=INFO
#Пароль для доступа к БД
database_user_password=
#Ключ для доступа к ИИ spring для модуля LLM
AI_API_KEY=
#Базовый адрес сервиса ИИ spring. Например https://api.groq.com/openai 
AI_BASE_URL=
#Используемая модель ИИ spring. Например llama-3.1-8b-instant
AI_MODEL=
#Конфигурация подключения к почтовому ящику для приема разовых кодов пользователей
#Имя сервера почты для приема разовых кодов (например webmail.gdev.by)
MAILBOX_HOST=
#имя пользователя для входа на сервер почты для приема разовых кодов
MAILBOX_USERNAME=
#пароль пользователя для входа на сервер почты для приема разовых кодов
MAILBOX_PWD=
#Путь к файлу с прокси для чтения прокси из файла
PROXY_FILE=
#Урл для обновления прокси раз в 24 ч
PROXY_URL=