#!groovy
pipeline {
    agent any
    //java should be 17
    tools {
        jdk 'jdk_17'
    }
    environment {
        REVISION = "1.0.${BUILD_ID}"
        APP_CONFIG_FILENAME = "alert-job-gateway/src/main/resources/static/index.html"
    }

    stages {
        stage('Prepare') {
            steps {
                // SCM checkout уже выполнен (Declarative: Checkout SCM / Pipeline from SCM)
                bat 'git log -1 --oneline'
                script {
                    config = readFile "${APP_CONFIG_FILENAME}"
                    newconfig = config.replaceAll('build_version', "${REVISION}")
                    writeFile file: "${APP_CONFIG_FILENAME}", text: "${newconfig}"
                }
            }
        }
        stage('Build') {
            parallel {
                stage('Front image') {
                    steps {
                        bat "cd front && docker build --build-arg REVISION=${REVISION} -t rg.gdev.by/alert-job/front:${REVISION} ."
                    }
                }
                stage('Maven modules') {
                    steps {
                        bat "mvn -Drevision=${REVISION} -Ddocker.skip=true -T 1C clean install -DskipTests"
                    }
                }
            }
        }
        stage('Push images to docker repo') {
            steps {
                withCredentials(bindings: [usernamePassword(credentialsId: 'registryuser', usernameVariable: 'usernameVariable', passwordVariable: 'passwordVariable')]) {
                    // Последовательный reactor build — parallel dockerfile:build падает на Docker Desktop (Windows)
                    bat "mvn -Drevision=${REVISION} -Dregistry.username=%usernameVariable% -Dregistry.password=%passwordVariable% -DskipTests -pl alert-job-config,alert-job-eureka,alert-job-gateway,core-alert-job,notification-alert-job,parser-alert-job,llm-alert-job -am dockerfile:build dockerfile:push"
                    bat "docker image push rg.gdev.by/alert-job/front:${REVISION}"
                }
            }
        }
        stage('replace and restart') {
            steps {
                bat "ssh server \"sed -i 's/alert_job_version=.*/alert_job_version=${REVISION}/' /home/app/service/aj/.env\""
                bat 'ssh server "cd /home/app/service/aj && /home/app/service/aj/now_up.sh"'
            }
        }
    }
}
