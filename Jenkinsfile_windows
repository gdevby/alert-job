#!groovy
pipeline {
    agent any
    //java should be 17
    tools {
        jdk 'jdk_17'
    }
    environment {
        REVISION = "1.0.${BUILD_ID}"
        APP_CONFIG_FILENAME = "alert-job-gateway/src/main/resources/static/index.html"
        DOCKER_PUSH_CMD = 'mvn -Drevision=%REVISION% -Dregistry.username=%usernameVariable% -Dregistry.password=%passwordVariable% -DskipTests package dockerfile:build dockerfile:push'
    }

    stages {
        stage('Prepare') {
            steps {
                bat 'git reset --hard'
                script {
                    config = readFile "${APP_CONFIG_FILENAME}"
                    newconfig = config.replaceAll("build_version", "${REVISION}")
                    writeFile file: "${APP_CONFIG_FILENAME}", text: "${newconfig}"
                }
            }
        }
        stage('Build') {
            parallel {
                stage('Front image') {
                    steps {
                        bat 'cd front && docker build --build-arg REVISION=%REVISION% -t rg.gdev.by/alert-job/front:%REVISION% .'
                    }
                }
                stage('Maven modules') {
                    steps {
                        bat 'mvn -Drevision=%REVISION% -Ddocker.skip=true -T 1C clean install'
                    }
                }
            }
        }
        stage('Push images to docker repo') {
            steps {
                script {
                    withCredentials(bindings: [usernamePassword(credentialsId: 'registryuser', usernameVariable: 'usernameVariable', passwordVariable: 'passwordVariable')]) {
                        parallel(
                            'config': {
                                bat 'cd alert-job-config && %DOCKER_PUSH_CMD%'
                            },
                            'eureka': {
                                bat 'cd alert-job-eureka && %DOCKER_PUSH_CMD%'
                            },
                            'gateway': {
                                bat 'cd alert-job-gateway && %DOCKER_PUSH_CMD%'
                            },
                            'core': {
                                bat 'cd core-alert-job && %DOCKER_PUSH_CMD%'
                            },
                            'notification': {
                                bat 'cd notification-alert-job && %DOCKER_PUSH_CMD%'
                            },
                            'parser': {
                                bat 'cd parser-alert-job && %DOCKER_PUSH_CMD%'
                            },
                            'llm': {
                                bat 'cd llm-alert-job && %DOCKER_PUSH_CMD%'
                            },
                            'front': {
                                bat 'docker image push rg.gdev.by/alert-job/front:%REVISION%'
                            }
                        )
                    }
                }
            }
        }
    }
}
