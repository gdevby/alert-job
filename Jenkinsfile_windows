#!groovy
pipeline {
    agent any
    //java should be 17
    tools {
        jdk 'jdk_17'
    }
    environment {
        REVISION = "1.0.${BUILD_ID}"
        APP_CONFIG_FILENAME = "alert-job-gateway/src/main/resources/static/index.html"
        GIT_REPO_URL = 'git@github.com:gdevby/alert-job.git'
        GIT_BRANCH = 'main'
        GIT_CREDENTIALS_ID = 'github.com_robert_makrytski'
    }

    stages {
        stage('Prepare') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${GIT_BRANCH}"]],
                    extensions: [[$class: 'CleanBeforeCheckout']],
                    userRemoteConfigs: [[
                        url: "${GIT_REPO_URL}",
                        credentialsId: "${GIT_CREDENTIALS_ID}"
                    ]]
                ])
                bat 'git log -1 --oneline'
                script {
                    config = readFile "${APP_CONFIG_FILENAME}"
                    newconfig = config.replaceAll('build_version', "${REVISION}")
                    writeFile file: "${APP_CONFIG_FILENAME}", text: "${newconfig}"
                }
            }
        }
        stage('Build') {
            parallel {
                stage('Front image') {
                    steps {
                        bat "cd front && docker build --build-arg REVISION=${REVISION} -t rg.gdev.by/alert-job/front:${REVISION} ."
                    }
                }
                stage('Maven modules') {
                    steps {
                        bat "mvn -Drevision=${REVISION} -Ddocker.skip=true -T 1C clean install -DskipTests"
                    }
                }
            }
        }
        stage('Push images to docker repo') {
            steps {
                script {
                    withCredentials(bindings: [usernamePassword(credentialsId: 'registryuser', usernameVariable: 'usernameVariable', passwordVariable: 'passwordVariable')]) {
                        def pushModule = { String module ->
                            bat """
                                cd ${module} && mvn -Drevision=${REVISION} -Dregistry.username=%usernameVariable% -Dregistry.password=%passwordVariable% -DskipTests dockerfile:build dockerfile:push
                            """
                        }
                        parallel(
                            'config': { pushModule('alert-job-config') },
                            'eureka': { pushModule('alert-job-eureka') },
                            'gateway': { pushModule('alert-job-gateway') },
                            'core': { pushModule('core-alert-job') },
                            'notification': { pushModule('notification-alert-job') },
                            'parser': { pushModule('parser-alert-job') },
                            'llm': { pushModule('llm-alert-job') },
                            'front': {
                                bat "docker image push rg.gdev.by/alert-job/front:${REVISION}"
                            }
                        )
                    }
                }
            }
        }
        stage('replace and restart') {
            steps {
                bat "ssh server \"sed -i 's/alert_job_version=.*/alert_job_version=${REVISION}/' /home/app/service/aj/.env\""
                bat 'ssh server "cd /home/app/service/aj && /home/app/service/aj/now_up.sh"'
            }
        }
    }
}
